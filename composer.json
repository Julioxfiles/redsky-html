{
    "name": "redsky/html",
    "description": "A PHP object-oriented HTML generation library for building HTML documents, elements, components and attributes.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "RedSky\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedSky\\Html\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}